# JobTracker 后端配置
# 拷贝为 .env 后填入真实值。
# AI Key 可以在 .env 配置（首次启动作为默认值），也可以在前端「设置 → AI 模型配置」改写。
# 前端写入的 Key 会保存到 SQLite，覆盖 .env 同名值。

# 服务监听
PORT=3000
HOST=127.0.0.1

# AI Key（任意一个即可启动；其余 provider 在前端配置）
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Tavily 搜索 API Key（用于"全网情报"功能；https://tavily.com 注册免费 1000 次/月）
# 可以在 .env 配置，也可以在前端「设置」页改写并保存到 SQLite。
TAVILY_API_KEY=

# AI 调用限流（次/分钟）
AI_RATE_LIMIT_PER_MIN=60

# AI 单次请求超时（毫秒）
AI_TIMEOUT_MS=90000

# 调试日志：AI_LOG=1 时每次代理调用打印 provider/purpose/len
# AI_LOG=1
